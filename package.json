{
  "name": "ksante-shop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "K'Sante Headwear - ร้านขายหมวกออนไลน์บน Cloudflare Pages + Pages Functions + D1",
  "scripts": {
    "dev": "wrangler pages dev",
    "db:init:local": "wrangler d1 execute ksante-db --local --file=./schema.sql",
    "db:seed:local": "wrangler d1 execute ksante-db --local --file=./seed.sql",
    "db:reset:local": "npm run db:init:local && npm run db:seed:local",
    "db:init:remote": "wrangler d1 execute ksante-db --remote --file=./schema.sql",
    "db:seed:remote": "wrangler d1 execute ksante-db --remote --file=./seed.sql",
    "db:migrate:images:local": "wrangler d1 execute ksante-db --local --file=./migrations/0002_images.sql",
    "db:migrate:images:remote": "wrangler d1 execute ksante-db --remote --file=./migrations/0002_images.sql",
    "test:api": "node tests/api-smoke.mjs http://127.0.0.1:8788",
    "deploy": "wrangler pages deploy"
  },
  "devDependencies": {
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": ">=20"
  }
}
